{
  "entities": {
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Digital cyber cafe service managed by Aditya Online Center admin and displayed in the website and Android catalogues.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Shared business identifier ('aditya_online_center') used for scoped catalogue queries."
        },
        "title": {
          "type": "string",
          "description": "Service title in English."
        },
        "titleHi": {
          "type": "string",
          "description": "Service title in Hindi."
        },
        "category": {
          "type": "string",
          "description": "Service category key (built-in or admin-created custom category ID)."
        },
        "shortDescription": {
          "type": "string",
          "description": "Concise summary shown on service cards (English)."
        },
        "shortDescriptionHi": {
          "type": "string",
          "description": "Concise summary shown on service cards (Hindi)."
        },
        "description": {
          "type": "string",
          "description": "Detailed description in English."
        },
        "descriptionHi": {
          "type": "string",
          "description": "Detailed description in Hindi."
        },
        "price": {
          "type": "integer",
          "description": "Authoritative service fee in INR."
        },
        "turnaroundTime": {
          "type": "string",
          "description": "Estimated processing time."
        },
        "iconKey": {
          "type": "string",
          "description": "Identifier for the built-in searchable service icon."
        },
        "requirements": {
          "type": "array",
          "description": "Bounded list of required/optional document specifications (up to 25 strings)."
        },
        "imageUrl": {
          "type": "string",
          "description": "HTTPS URL or compressed data URI for the service cover image."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the service can currently be ordered by customers."
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether the service is highlighted in the Featured section on Home."
        },
        "featuredOrder": {
          "type": "integer",
          "description": "Priority sort position among featured services."
        },
        "sortOrder": {
          "type": "integer",
          "description": "Display order position in the main service catalogue."
        },
        "isArchived": {
          "type": "boolean",
          "description": "Soft-deletion / archival flag preserving historical orders."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "tenantId",
        "title",
        "titleHi",
        "category",
        "description",
        "descriptionHi",
        "price",
        "turnaroundTime",
        "requirements",
        "imageUrl",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "ServiceCategoryItem": {
      "title": "ServiceCategoryItem",
      "description": "Service category managed by admins and shared between the website and Android app.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Shared business identifier ('aditya_online_center')."
        },
        "key": {
          "type": "string",
          "description": "Unique category slug/key."
        },
        "labelEn": {
          "type": "string",
          "description": "Category display name in English."
        },
        "labelHi": {
          "type": "string",
          "description": "Category display name in Hindi."
        },
        "iconKey": {
          "type": "string",
          "description": "Icon identifier for the category."
        },
        "sortOrder": {
          "type": "integer",
          "description": "Display order of the category."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the category is active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": [
        "tenantId",
        "key",
        "labelEn",
        "labelHi",
        "iconKey",
        "sortOrder",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Shared business contact information, working hours, and social media profiles for Aditya Online Center.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Shared business identifier ('aditya_online_center')."
        },
        "centerName": {
          "type": "string",
          "description": "Business display name."
        },
        "ownerName": {
          "type": "string",
          "description": "Proprietor / owner display name."
        },
        "whatsappNumber": {
          "type": "string",
          "description": "10-digit WhatsApp business number."
        },
        "phoneNumber": {
          "type": "string",
          "description": "10-digit support phone number."
        },
        "email": {
          "type": "string",
          "description": "Support email address."
        },
        "location": {
          "type": "string",
          "description": "Shop address and locality in Kateya, Gopalganj, Bihar."
        },
        "workingHours": {
          "type": "string",
          "description": "Business operating hours."
        },
        "contactInstructions": {
          "type": "string",
          "description": "Optional customer contact instructions."
        },
        "instagramUrl": {
          "type": "string",
          "description": "Instagram profile URL."
        },
        "facebookUrl": {
          "type": "string",
          "description": "Facebook profile URL."
        },
        "youtubeUrl": {
          "type": "string",
          "description": "YouTube channel URL."
        },
        "telegramUrl": {
          "type": "string",
          "description": "Telegram channel/chat URL."
        },
        "githubUrl": {
          "type": "string",
          "description": "GitHub profile URL."
        },
        "websiteUrl": {
          "type": "string",
          "description": "Official web portal URL."
        },
        "socialLinksSpec": {
          "type": "array",
          "description": "Ordered list of serialized social media profile entries (up to 15 strings)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": [
        "tenantId",
        "centerName",
        "ownerName",
        "whatsappNumber",
        "phoneNumber",
        "email",
        "location",
        "workingHours",
        "contactInstructions",
        "instagramUrl",
        "facebookUrl",
        "youtubeUrl",
        "telegramUrl",
        "githubUrl",
        "websiteUrl",
        "socialLinksSpec",
        "updatedAt"
      ]
    },
    "ServiceOrder": {
      "title": "ServiceOrder",
      "description": "Customer order submitted from either the website or native Android app into the shared order database.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "description": "Human-readable unique order ID (e.g., AOC-20261026-1234)."
        },
        "userId": {
          "type": "string",
          "description": "Authenticated customer UID for rule ownership enforcement."
        },
        "customerUid": {
          "type": "string",
          "description": "Authenticated customer UID (matches userId)."
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the applicant."
        },
        "customerPhone": {
          "type": "string",
          "description": "10-digit Indian mobile number of the applicant."
        },
        "customerEmail": {
          "type": "string",
          "description": "Email address of the customer."
        },
        "sourceChannel": {
          "type": "string",
          "enum": ["android", "website"],
          "description": "Origin channel of the order."
        },
        "serviceId": {
          "type": "string",
          "description": "ID of the ordered service in /services/{serviceId}."
        },
        "serviceTitleSnapshot": {
          "type": "string",
          "description": "Service title captured at order time."
        },
        "priceSnapshot": {
          "type": "integer",
          "description": "Verified service price in INR captured at order time."
        },
        "applicantDetailsSummary": {
          "type": "string",
          "description": "Structured summary of service-specific application fields."
        },
        "documentLinks": {
          "type": "array",
          "description": "Bounded list of attached document file names or cloud share links (up to 10 strings)."
        },
        "upiReference": {
          "type": "string",
          "description": "Optional 12-digit UPI UTR reference provided for manual admin verification."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "pending_verification", "verified", "rejected"],
          "description": "Payment verification status (only admins can mark verified)."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "action_required", "completed", "cancelled"],
          "description": "Order fulfillment status."
        },
        "adminNotes": {
          "type": "string",
          "description": "Remarks or instructions added by the admin."
        },
        "deliveryFileUrl": {
          "type": "string",
          "description": "HTTPS download URL for the completed document provided by admin."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "orderNumber",
        "userId",
        "customerUid",
        "customerName",
        "customerPhone",
        "customerEmail",
        "sourceChannel",
        "serviceId",
        "serviceTitleSnapshot",
        "priceSnapshot",
        "applicantDetailsSummary",
        "documentLinks",
        "upiReference",
        "paymentStatus",
        "status",
        "adminNotes",
        "deliveryFileUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer profile and preferences stored under /users/{userId}.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "description": "Customer display name."
        },
        "email": {
          "type": "string",
          "description": "Customer email address."
        },
        "phone": {
          "type": "string",
          "description": "Customer 10-digit mobile number."
        },
        "address": {
          "type": "string",
          "description": "Customer locality/village in Kateya, Bihar."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "hi"],
          "description": "Preferred UI language code."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "name",
        "email",
        "phone",
        "address",
        "preferredLanguage",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator marker document under /admins/{adminId}.",
      "type": "object",
      "properties": {
        "adminId": {
          "type": "string",
          "description": "Administrator UID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": ["adminId", "createdAt"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItem" },
      "description": "Shared service catalogue managed by admins and read by authenticated customers."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/ServiceCategoryItem" },
      "description": "Shared service categories managed by admins and read by authenticated customers."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Shared business contact details, working hours, and social media profiles."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/ServiceOrder" },
      "description": "Shared order collection storing website and Android customer orders."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile documents restricted to owner or admin."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Read-only admin authorization lookup collection."
    }
  }
}
